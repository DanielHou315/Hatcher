# Copy to .envrc (gitignored), fill in, then `direnv allow`. See docs/deployment.md.

# Root of the live data, outside the repo. Content is service data and is never committed.
export HATCHER_HOME="$HOME/Databases/hatcher"

# Live MDX content the site serves and the agent writes. Default (compose): ./content
export CONTENT_DIR="$HATCHER_HOME/content"

# Directory holding the SQLite progress database. Default (compose): ./data
export DATA_DIR="$HATCHER_HOME/database"

# Agent-owned state: queue.md, logs/, Claude Code config, caches. Default (compose): ./data/agent
export AGENT_DIR="$HATCHER_HOME/agent"

# Checkout of the paper-to-guided-learning plugin, mounted read-only into the agent.
export PLUGIN_DIR="$HOME/Code/paper-to-guided-learning-plugin"

# Optional: origin that serves sandboxed HTML pages and figures, proxied to this same app.
# Empty serves them from the site's own origin (still sandboxed). See docs/architecture.md.
export CONTENT_ORIGIN=""

# Optional: the site's public origin, allowed to frame content served from CONTENT_ORIGIN.
export SITE_ORIGIN=""

# public (default): the anonymous, read-only site. Published pages only; no accounts, no write
# APIs, no secrets, and DATA_DIR is never opened. studio: the sign-in-only instance for accounts,
# drafts, API keys and MCP. Deploy them as two containers from the same image.
export HATCHER_MODE="studio"

# --- Accounts (studio only, Better Auth). Accounts, sessions and API keys live in $DATA_DIR/auth.db. ---

# Signs sessions and content tokens. Required in production: `openssl rand -base64 32`. Never commit it.
export BETTER_AUTH_SECRET=""

# Public URL of the site (OAuth callbacks, trusted origin). Defaults to SITE_ORIGIN.
export BETTER_AUTH_URL=""

# Comma-separated emails that become admins when they sign up. Use this to create the first admin.
export HATCHER_ADMIN_EMAILS=""

# closed (default): only admins create accounts. open: anyone may sign up as a reader.
export HATCHER_SIGNUP="closed"

# Optional OAuth sign-in. Callback URL: $BETTER_AUTH_URL/api/auth/callback/<github|google>.
export GITHUB_CLIENT_ID=""
export GITHUB_CLIENT_SECRET=""
export GOOGLE_CLIENT_ID=""
export GOOGLE_CLIENT_SECRET=""

# Port the site listens on.
export PORT=3000

# Set to 1 when the content directory is a bind mount or network share and native file events
# do not fire. The site outside Docker uses 0; compose forces 1 inside the container.
export CHOKIDAR_USEPOLLING=0

# Claude Code credential for the agent, from `claude setup-token` on the host. Never commit it.
# (ANTHROPIC_API_KEY also works instead, billed to the API account.)
export CLAUDE_CODE_OAUTH_TOKEN=""

# When the agent runs: a cron expression in the container's local time (AGENT_TZ).
export AGENT_SCHEDULE="0 6 * * *"

# Time zone for the schedule, logs, and queue dates.
export AGENT_TZ="America/Los_Angeles"

# Upper bound on agent turns per run (each run also times out after two hours).
export AGENT_MAX_TURNS=80

# Model for agent runs. Empty uses the Claude Code default; otherwise e.g. claude-opus-5-5.
export AGENT_MODEL=""

# Optional: xAI key that enables the X source in `p2gl scout`.
export XAI_API_KEY=""

# Optional: Semantic Scholar key for higher rate limits.
export S2_API_KEY=""
