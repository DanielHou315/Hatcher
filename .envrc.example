# Copy to .envrc (gitignored), fill in, then `direnv allow`. See docs/deployment.md.

# Directory holding everything: auth.db, hatcher.db and pages/. Back it up. Default (compose): ./data
export DATA_DIR="$HOME/Databases/hatcher/database"

# Signs sessions and page-frame tokens, and encrypts the SMTP password. Required in production:
# `openssl rand -base64 32`. Never commit it; changing it signs everyone out.
export BETTER_AUTH_SECRET=""

# The URL people open, e.g. https://hatcher.example.com. Sign-in only works from this origin, and
# email links and API results point at it. Defaults to SITE_ORIGIN.
export BETTER_AUTH_URL=""

# Other addresses people open the site at (comma-separated origins), e.g. a LAN or VPN address:
# "http://192.168.1.10:3000,http://10.0.0.5:3000". Sign-in from any other address is refused as
# "Invalid origin". Cookies are marked Secure when BETTER_AUTH_URL is https, so plain-http addresses
# here only work while BETTER_AUTH_URL is http too.
export HATCHER_TRUSTED_ORIGINS=""

# Comma-separated emails that may register and become admins while no admin exists. Use it to create
# the first admin, then remove it. Who else may register is set at /admin (starts closed).
export HATCHER_ADMIN_EMAILS=""

# The request header holding the visitor's address, for rate limits. It must be one your reverse
# proxy sets and overwrites, or visitors can choose their own: "cf-connecting-ip" behind Cloudflare.
# Default: x-forwarded-for.
export HATCHER_CLIENT_IP_HEADER=""

# Optional: origin that serves page files, proxied to this same app, for an extra layer of
# isolation. Empty serves them from the site's own origin (still sandboxed). See docs/architecture.md.
export CONTENT_ORIGIN=""

# Optional: the site's public origin, allowed to frame page files served from CONTENT_ORIGIN.
export SITE_ORIGIN=""

# Optional OAuth sign-in. Callback URL: $BETTER_AUTH_URL/api/auth/callback/<github|google>.
# New OAuth accounts follow the same registration rules as email sign-up.
export GITHUB_CLIENT_ID=""
export GITHUB_CLIENT_SECRET=""
export GOOGLE_CLIENT_ID=""
export GOOGLE_CLIENT_SECRET=""

# Port the site listens on.
export PORT=3000
