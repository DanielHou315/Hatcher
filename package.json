{
  "name": "hatcher",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "predev": "node scripts/vendor-libs.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/vendor-libs.mjs",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "lint": "eslint . --max-warnings 0 && tsc --noEmit",
    "validate:content": "tsx --conditions=react-server scripts/validate-content.ts",
    "docker:up": "bash scripts/seed-content.sh && docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f site",
    "content:seed": "bash scripts/seed-content.sh",
    "content:import": "bash scripts/import-content.sh",
    "agent:run-now": "docker compose run --rm --no-deps agent /app/agent/run-job.sh",
    "agent:dry-run": "docker compose run --rm --no-deps agent /app/agent/run-job.sh --dry-run",
    "agent:logs": "docker compose logs -f agent"
  },
  "dependencies": {
    "@better-auth/api-key": "1.7.25",
    "@fontsource-variable/newsreader": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@mdx-js/mdx": "3.1.1",
    "better-auth": "1.7.25",
    "chokidar": "5.0.0",
    "gray-matter": "4.0.3",
    "katex": "0.18.9",
    "next": "15.5.26",
    "next-mdx-remote": "6.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "rehype-katex": "7.0.1",
    "rehype-slug": "6.0.0",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "server-only": "0.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.7",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.13.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.26",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.1"
  }
}
