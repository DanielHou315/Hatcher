{
  "name": "hatcher",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "predev": "node scripts/vendor-libs.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/vendor-libs.mjs",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "lint": "eslint . --max-warnings 0 && tsc --noEmit",
    "validate:content": "tsx --conditions=react-server scripts/validate-content.ts",
    "docker:up": "bash scripts/init-dirs.sh && docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f site"
  },
  "dependencies": {
    "@better-auth/api-key": "1.7.25",
    "@fontsource-variable/newsreader": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@mdx-js/mdx": "3.1.1",
    "@modelcontextprotocol/sdk": "1.32.2",
    "better-auth": "1.7.25",
    "chokidar": "5.0.0",
    "gray-matter": "4.0.3",
    "katex": "0.19.1",
    "next": "15.5.29",
    "next-mdx-remote": "6.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "rehype-katex": "7.0.1",
    "rehype-slug": "6.0.0",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.7",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.29",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  },
  "overrides": {
    "katex": "$katex"
  }
}
